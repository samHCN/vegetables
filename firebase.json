{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "web", 
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "idx-vegetables-8980006",
          "region": "europe-west3"
        }
      }
    ]
  }
}

